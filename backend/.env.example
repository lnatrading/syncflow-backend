# ============================================================
#  SyncFlow Backend — Environment Variables
#  Copy this file to .env and fill in your real values
#  NEVER commit .env to GitHub
# ============================================================

# Supabase (get these from your Supabase project → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Port (Railway sets this automatically — don't change)
PORT=3000

# Mediamax (Spanish distributor — API v1.6.2)
# Token: contact customer@mediamax.es to obtain one
# Account email: must match the email registered at api.mediamax.es
MEDIAMAX_TOKEN=your_bearer_token_here
MEDIAMAX_ACCOUNT_EMAIL=your_mediamax_account_email@example.com
